{
  "name": "cuajs",
  "outputFilename": "cua",
  "prettyName": "CuaJs",
  "codeName": "CuaJs",
  "version": "0.0.7",
  "tagline": "Crab-walk through your website with CuaJs.",
  "description": "CuaJs is a lightweight, powerful JavaScript library that transforms traditional vertical scrolling into a smooth, intuitive horizontal experience.",
  "homepage": "https://phucbm.github.io/cuajs",
  "repository": {
    "type": "git",
    "url": "git@github.com:phucbm/cuajs"
  },
  "author": {
    "name": "phucbm",
    "url": "https://github.com/phucbm"
  },
  "keywords": [
    "phucbm",
    "javascript",
    "es6",
    "scroll",
    "horizontal-scroll",
    "lenis"
  ],
  "main": "./dist/cua.module.js",
  "files": [
    "./dist/*"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "sass:compressed": "sass src/_style.scss:dist/cua-animate.css --no-source-map",
    "optimize": "node -e \"const fs=require('fs');fs.writeFileSync('dist/cua-animate.min.css',require('csso').minify(fs.readFileSync('dist/cua-animate.css','utf8')).css)\"",
    "output-css": "npm run sass:compressed && npm run optimize",
    "dev": "webpack serve --config config/webpack.dev.js",
    "build": "cross-env BASE_URL=https://phucbm.github.io/cuajs ENTRY=dev webpack --config config/webpack.build.js",
    "prod-umd": "cross-env TARGET=umd webpack --config config/webpack.prod.js",
    "prod-module": "cross-env TARGET=module webpack --config config/webpack.prod.js",
    "prod": "npm run prod-umd && npm run prod-module && npm run output-css"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "babel-loader": "^10.1.1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "csso": "^5.0.5",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.30",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.9.10",
    "sass": "^1.105.2",
    "sass-loader": "^17.0.1",
    "shiki": "^4.5.0",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.112.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "@phucbm/os-util": "^0.0.5"
  },
  "packageManager": "pnpm@10.22.0",
  "pnpm": {
    "overrides": {
      "postcss-selector-parser@<7.1.6": "^7.1.6"
    }
  }
}
